<mujoco model="mlspaces-house">
  <compiler angle="radian"/>

  <option impratio="10" gravity="0 0 -9.8" integrator="implicitfast" cone="elliptic" jacobian="sparse" noslip_iterations="4">
    <flag energy="enable" multiccd="enable"/>
  </option>

  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality shadowsize="16384"/>
    <headlight ambient="0.35 0.35 0.35"/>
    <map znear="0.001"/>
  </visual>

  <default>
    <default class="/">
      <default class="__VISUAL_MJT__">
        <geom contype="0" conaffinity="0"/>
      </default>
      <default class="__STRUCTURAL_MJT__">
        <geom contype="8" conaffinity="15" group="4" friction="0.9 0.9 0.001" solref="0.025" solimp="0.998 0.998" density="500"/>
        <default class="__STRUCTURAL_WALL_MJT__">
          <geom group="3"/>
        </default>
      </default>
      <default class="__DYNAMIC_MJT__">
        <geom conaffinity="15" group="4" friction="0.9 0.9 0.001" solref="0.025" solimp="0.998 0.998" density="500"/>
      </default>
      <default class="__ARTICULABLE_DYNAMIC_MJT__">
        <geom contype="0" conaffinity="7" group="4" friction="0.9 0.9 0.001" solref="0.025" solimp="0.998 0.998" density="500"/>
      </default>
    </default>
  </default>

  <worldbody>
    <geom name="ground" size="5 5 0.01" type="plane" contype="8" conaffinity="15" rgba="0.3 0.3 0.3 1"/>
    <body name="desk" pos="0.75 0.45 0">
      <geom name="desk_top" size="0.5 0.25 0.015" pos="0 0 0.72" type="box" contype="8" conaffinity="15" rgba="0.55 0.35 0.2 1"/>
